rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /miniBrain/sharedState {
      allow read, write: if request.auth != null;
    }
    match /miniBrain/trainedModel {
      // العميل بيقراها بس عشان يعرض حالة السيرفر لو حبيت - الكتابة بتحصل من Cloud Functions فقط (لها صلاحيات admin تلقائيًا)
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
