{
  "rules": {

    "deviceRegistry": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['uid','lastSeen'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },

        "tokensExhausted": {
          ".validate": "newData.val() === true || (!data.exists() || data.val() != true)"
        },

        "exhaustedAt": { ".validate": "newData.isNumber()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "biometricRegistered": { ".validate": "newData.val() === true" },

        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        "security": {
          "biometric": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['credentialId','deviceId','registeredAt'])",

            "credentialId": { ".validate": "newData.isString()" },
            "deviceId": { ".validate": "newData.isString()" },
            "registeredAt": { ".validate": "newData.isNumber()" }
          },

          "devices": {
            "$deviceId": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['firstSeen','lastSeen'])",

              "firstSeen": {
                ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
              },
              "lastSeen": { ".validate": "newData.isNumber()" }
            }
          }
        }
      }
    }

  }
}
